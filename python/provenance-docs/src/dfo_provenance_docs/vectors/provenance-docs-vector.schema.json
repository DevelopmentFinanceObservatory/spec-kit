{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/ONEcampaign/dfo-spec-kit/main/python/provenance-docs/src/dfo_provenance_docs/vectors/provenance-docs-vector.schema.json",
  "title": "Provenance documentation vector record",
  "description": "One language-neutral conformance fixture for the provenance documentation grammar: a stored graph value, the function it passes through, and either the parsed result or the error reason and line. See the README beside this schema.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "description",
    "function",
    "input"
  ],
  "properties": {
    "id": {
      "description": "Stable, unique, kebab-case id. Matches the file name stem.",
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$"
    },
    "description": {
      "description": "One sentence stating what the vector proves.",
      "type": "string",
      "minLength": 1
    },
    "function": {
      "description": "The function under test. Every function other than decode_mcf_text runs on the decoded input.",
      "enum": [
        "decode_mcf_text",
        "parse_transformations",
        "parse_changelog",
        "parse_prose",
        "parse_notes"
      ]
    },
    "input": {
      "description": "The property value as the graph stores it: the body of a JSON string, with every quote written as \\u0022.",
      "type": "string"
    },
    "expect": {
      "description": "The result in JSON form. Its shape depends on function."
    },
    "error": {
      "$ref": "#/$defs/error"
    }
  },
  "oneOf": [
    {
      "required": [
        "expect"
      ]
    },
    {
      "required": [
        "error"
      ]
    }
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "function": {
            "enum": [
              "decode_mcf_text",
              "parse_prose"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "expect": {
            "type": "string"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "function": {
            "const": "parse_notes"
          }
        }
      },
      "then": {
        "properties": {
          "expect": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "function": {
            "const": "parse_transformations"
          }
        }
      },
      "then": {
        "properties": {
          "expect": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/$defs/step"
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "function": {
            "const": "parse_changelog"
          }
        }
      },
      "then": {
        "properties": {
          "expect": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/$defs/release"
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reason",
        "line"
      ],
      "properties": {
        "reason": {
          "description": "The rule the input breaks. The vocabulary is DocumentErrorReason.",
          "enum": [
            "undecodable",
            "document_too_large",
            "empty_document",
            "content_outside_section",
            "unexpected_heading_level",
            "heading_not_plain_text",
            "empty_heading",
            "empty_section",
            "disallowed_block",
            "nesting_too_deep",
            "raw_html",
            "hard_break",
            "invalid_release_heading",
            "missing_release_title",
            "release_dates_not_descending",
            "duplicate_release_date",
            "unknown_change_kind",
            "duplicate_change_kind",
            "not_single_bullet_list",
            "list_item_not_single_paragraph"
          ]
        },
        "line": {
          "description": "1-based line in the decoded document of the construct that breaks the rule: the line that holds inline HTML or ends in a hard break, or the first line of any other offending block. Null when the error has no line.",
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        }
      }
    },
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "description"
      ],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "release": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "date",
        "title",
        "changes"
      ],
      "properties": {
        "date": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "changes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "note"
            ],
            "properties": {
              "kind": {
                "enum": [
                  "added",
                  "changed",
                  "deprecated",
                  "removed",
                  "fixed",
                  "security"
                ]
              },
              "note": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    }
  }
}
