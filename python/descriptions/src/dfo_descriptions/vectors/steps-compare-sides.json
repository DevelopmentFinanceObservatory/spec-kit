        "content_version": "cv_0f1e2d3c4b5a69788796a5b4c3d2e1f0",
        "label": "France gross ODA disbursements"
      }
    },
    {
      "id": "s2",
      "op": "retrieve",
      "input": {
        "id": "spec_7c2e1d0f3a4b5c6d7e8f9a0b1c2d3e4f",
        "content_version": "cv_1a2b3c4d5e6f708192a3b4c5d6e7f809",
        "label": "United Kingdom gross ODA disbursements"
      }
    },
    {
      "id": "s3",
