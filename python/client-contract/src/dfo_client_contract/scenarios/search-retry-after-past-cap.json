{
  "format_version": 1,
  "name": "search-retry-after-past-cap",
  "description": "A retryable refusal whose Retry-After is past the 60-second cap raises at once, with no wait and no retry: ServerError with its code, service_unavailable, and its trace id.",
  "origin": {
    "kind": "synthetic",
    "derived_from": "search-place-ambiguous",
    "edit": "A 503 service_unavailable with retryable true and Retry-After 61 answers the search."
  },
  "call": [
    {
      "op": "search",
      "question": "ODA disbursements from Germany to Congo in 2018"
    }
  ],
  "exchanges": [
    {
      "request": {
        "method": "POST",
