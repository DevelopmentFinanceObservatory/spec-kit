{
  "format_version": 1,
  "name": "search-no-json-body",
  "description": "A 2xx Search response with no JSON body raises ContractError unexpected_response.",
  "origin": {
    "kind": "synthetic",
    "derived_from": "search-place-ambiguous",
    "edit": "The search answers 200 with an empty text/html body."
  },
  "call": [
    {
      "op": "search",
      "question": "ODA disbursements from Germany to Congo"
    }
  ],
  "exchanges": [
    {
      "request": {
        "method": "POST",
        "path": "/search/resolve",
        "json": {
          "schema_version": 1,
          "input": {
            "kind": "raw_text",
            "query": "ODA disbursements from Germany to Congo"
          }
        }
      },
      "response": {
        "status": 200,
        "headers": {
          "content-type": "text/html; charset=utf-8"
        }
      }
    }
  ],
  "expect": [
    {
      "error": {
        "class": "ContractError",
        "code": "unexpected_response"
      }
    }
  ]
}
