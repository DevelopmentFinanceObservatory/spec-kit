          "citation": {
            "text": "OECD Creditor Reporting System (CRS) (2026), via the Development Finance Observatory",
            "sources": [
              {
                "ref": "provenance/OECDCreditorReportingSystem",
                "label": "OECD Creditor Reporting System (CRS)",
                "license": "OECD Terms and Conditions",
                "license_type": "OECDTermsAndConditions",
                "license_url": "https://www.oecd.org/en/about/terms-conditions.html",
                "url": "https://data-explorer.oecd.org/vis?tm=crs&pg=0&snb=30&df[ds]=dsDisseminateFinalDMZ&df[id]=DSD_CRS%40DF_CRS&df[ag]=OECD.DCD.FSD&df[vs]=1.6&isAvailabilityDisabled=false&page=0",
                "source": {
                  "ref": "dc/s/OrganisationForEconomicCo-operationAndDevelopmentOecd",
                  "label": "Organisation for Economic Co-operation and Development (OECD)"
                },
                "data_commons": {
                  "id": "dfo",
                  "label": "Development Finance Observatory"
                },
                "documentation": {
                  "publisher": "Organisation for Economic Co-operation and Development (OECD)",
                  "description": "The Creditor Reporting System (CRS) is the OECD Development Assistance Committee's activity-level database of development finance. Each record is a project, programme or contribution reported by a bilateral provider, a multilateral organisation or a private foundation, with its recipient, sector and purpose, channel of delivery, aid type, and commitment and disbursement amounts. It covers ODA, other official flows, private sector instruments and private philanthropy, and is the source for any breakdown by sector, channel or project.",
                  "source_data_url": "https://webfs-dcd.oecd.org/files/dotStat/DSD_CRS/CRS.parquet",
                  "attribution": "OECD (2026), Creditor Reporting System (CRS), OECD Data Explorer, https://webfs-dcd.oecd.org/files/dotStat/DSD_CRS/CRS.parquet (accessed on 2026-10-15)",
                  "update_cadence": "Quarterly",
                  "last_update": "2026-10-15",
                  "years_covered": "1973-2024",
                  "granularity": "Annual, by provider and recipient",
                  "currencies": [
                    "USD"
                  ],
                  "transformation_log": [
                    {
                      "transformation": "Download the source data",
                      "description": "The complete CRS file is downloaded from the OECD each time the pipeline runs, and replaces the previous copy, so the data reflects the OECD's latest release."
                    },
                    {
                      "transformation": "Exclude the partial preliminary year",
                      "description": "Before each full release, the OECD publishes preliminary data for the year that release covers, as reporters submit it. Until then, that year is partial, so the pipeline excludes it. Support for partial years is in development. Partial years will be marked incomplete, so they don't lead to incorrect or confusing analyses."
                    },
                    {
                      "transformation": "Exclude donor core contributions to multilaterals",
                      "description": "The OECD instructs that donor core contributions to multilateral organisations, reported as ordinary CRS rows flagged `bi_multi = 2`, are excluded to compute bilateral flows. These contributions are already reported in Members' Total Use of the Multilateral System, so keeping them would double count."
                    },
                    {
                      "transformation": "Standardise providers and recipients",
                      "description": "Provider and recipient codes are standardised to Data Commons IDs used across the platform, so data can be compared across datasets."
                    },
                    {
                      "transformation": "Select dimensions",
                      "description": "Every figure is reported against the year, the provider and the recipient, and four dimensions from the CRS: type of flow, co-operation modality, type of finance and purpose code. The CRS describes each activity in far more detail than this, including project titles, descriptions, channels and policy markers, none of which is carried through."
                    },
                    {
                      "transformation": "Aggregate totals",
                      "description": "Activities sharing the same year, provider, recipient and dimensions are summed. Commitments, disbursements, net disbursements and grant equivalents are each aggregated as separate measures. Every figure is reported in US dollars at current prices."
                    }
                  ],
                  "version_history": [
                    {
                      "date": "2026-10-15",
                      "title": "Partial preliminary year excluded",
                      "changes": [
                        {
                          "kind": "changed",
                          "note": "The partial preliminary year published ahead of the next full release is excluded."
                        }
                      ]
                    },
                    {
                      "date": "2026-10-14",
                      "title": "First release",
                      "changes": [
                        {
                          "kind": "added",
                          "note": "Commitments, gross and net disbursements, and grant equivalents by donor, recipient, flow type, finance type, modality and purpose, at current US dollar prices. Covers ODA, other official flows, private development finance and private sector instruments."
                        }
                      ]
                    }
                  ]
                }
              }
            ]
          },
