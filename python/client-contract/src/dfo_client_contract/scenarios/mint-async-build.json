            "citation": {
              "text": "OECD DAC2A (2026), via the Development Finance Observatory",
              "sources": [
                {
                  "ref": "provenance/OECDDAC2A",
                  "label": "OECD DAC2A",
                  "license": "OECD Terms and Conditions",
                  "license_type": "OECDTermsAndConditions",
                  "license_url": "https://www.oecd.org/en/about/terms-conditions.html",
                  "url": "https://data-explorer.oecd.org/vis?tm=dac2a&pg=0&snb=1&df[ds]=dsDisseminateFinalDMZ&df[id]=DSD_DAC2%40DF_DAC2A&df[ag]=OECD.DCD.FSD&df[vs]=1.6&dq=.DPGC.206.USD.Q&lom=LASTNPERIODS&lo=5&to[TIME_PERIOD]=false&isAvailabilityDisabled=false&page=0",
                  "source": {
                    "ref": "dc/s/OrganisationForEconomicCo-operationAndDevelopmentOecd",
                    "label": "Organisation for Economic Co-operation and Development (OECD)"
                  },
                  "data_commons": {
                    "id": "dfo",
                    "label": "Development Finance Observatory"
                  },
                  "documentation": {
                    "publisher": "Organisation for Economic Co-operation and Development (OECD)",
                    "description": "DAC2A is the OECD Development Assistance Committee's table of ODA disbursements by donor and recipient country or region. It covers bilateral donors and multilateral agencies reporting their own outflows, and includes the OECD's estimate of each donor's core multilateral contributions attributed to recipients.",
                    "source_data_url": "https://webfs-dcd.oecd.org/files/dotStat/DSD_DAC2/Table2a_Data.zip",
                    "attribution": "OECD (2026), OECD DAC2A, OECD Data Explorer, https://webfs-dcd.oecd.org/files/dotStat/DSD_DAC2/Table2a_Data.zip (accessed on 2026-10-12)",
                    "update_cadence": "Quarterly",
                    "last_update": "2026-10-15",
                    "years_covered": "1960-2024",
                    "granularity": "Annual, by provider and recipient",
                    "currencies": [
                      "USD"
                    ],
                    "transformation_log": [
                      {
                        "transformation": "Download the source data",
                        "description": "The OECD publishes DAC2A in April, June, September and December. The complete table is downloaded from the OECD each time it is republished, and replaces the previous copy, so the data reflects the OECD's latest release."
                      },
                      {
                        "transformation": "Exclude the partial preliminary year",
                        "description": "Before each full release, the OECD publishes preliminary data for the year that release covers, as reporters submit it. Until then, that year is partial, so the pipeline excludes it. Support for partial years is in development. Partial years will be marked incomplete, so they don't lead to incorrect or confusing analyses."
                      },
                      {
                        "transformation": "Standardise providers and recipients",
                        "description": "Provider and recipient codes are standardised to Data Commons IDs used across the platform, so data can be compared across datasets. The totals DAC2A reports for groups of providers, such as all DAC countries, and for groups of recipients, such as regions and income groups, are included as providers and recipients of their own. Where two provider codes name the same organisation and report the same figures, the figures are counted once. Where two recipient codes name the same organisation, such as IDA and IDA's Multilateral Debt Relief Initiative, their flows are added."
                      },
                      {
                        "transformation": "Select figures",
                        "description": "Only figures in current US dollars are included, not constant US dollars. Only flows to recipients on Part I of the DAC List are included: the developing countries, and the multilateral organisations DAC2A reports as recipients, such as development banks and UN agencies. Flows to Part II recipients, the countries in transition, are excluded."
                      },
                      {
                        "transformation": "Convert to whole units",
                        "description": "DAC2A reports amounts in millions, which are converted to whole units. ODA per person and ODA as a share of GNI are kept as reported."
                      },
                      {
                        "transformation": "Select dimensions",
                        "description": "Each figure is reported by year, provider, recipient and type of aid, such as grants, repayments, interest received, or debt forgiven or rescheduled. DAC2A is a table of disbursements, so every figure, repayments and interest included, is recorded as a disbursement. Figures are marked as gross or net, except where DAC2A does not say which, and as grants or non-grants where the type of aid is wholly one or the other. Imputed multilateral ODA, the OECD's estimate of each provider's share of multilateral organisations' ODA, is marked as modelled. ODA as a share of GNI records the recipient's GNI as its denominator, and ODA per person records the recipient's population."
                      }
                    ],
                    "version_history": [
                      {
                        "date": "2026-10-15",
                        "title": "Partial preliminary year excluded",
                        "changes": [
                          {
                            "kind": "changed",
                            "note": "The partial preliminary year published ahead of the next full release is excluded."
                          }
                        ]
                      },
                      {
                        "date": "2026-10-14",
                        "title": "First release",
                        "changes": [
                          {
                            "kind": "added",
                            "note": "ODA disbursements by donor and recipient country or region, including the OECD's imputed multilateral contributions, and ODA per person and as a share of recipient GNI."
                          }
                        ]
                      }
                    ]
                  }
                }
              ]
