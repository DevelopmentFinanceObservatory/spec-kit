{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/DevelopmentFinanceObservatory/spec-kit/main/python/client-contract/src/dfo_client_contract/warning-codes.schema.json",
  "title": "Warning codes",
  "description": "Each code a client sets on a warning it issues itself, with the warning class and the condition, sorted by code. A SearchWarning or DataWarning carries the server's code, so neither is listed.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format_version",
    "codes"
  ],
  "properties": {
    "format_version": {
      "const": 1
    },
    "codes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "code",
          "class",
          "condition"
        ],
        "properties": {
          "code": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]*(_[a-z0-9]+)*$"
          },
          "class": {
            "enum": [
              "DfoWarning",
              "DfoDeprecationWarning"
            ]
          },
          "condition": {
            "description": "The condition, in one line.",
            "type": "string",
            "minLength": 1,
            "not": {
              "pattern": "\\n"
            }
          }
        }
      }
    }
  }
}
