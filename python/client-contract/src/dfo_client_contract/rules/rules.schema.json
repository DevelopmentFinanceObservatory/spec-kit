{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/DevelopmentFinanceObservatory/spec-kit/main/python/client-contract/src/dfo_client_contract/rules/rules.schema.json",
  "title": "Client rule vectors",
  "description": "One file per rule, each holding the vectors a client's implementation of that rule must reproduce. rules/README.md states each rule.",
  "type": "object",
  "oneOf": [
    {
      "$ref": "#/$defs/key_format"
    },
    {
      "$ref": "#/$defs/credentials_path"
    },
    {
      "$ref": "#/$defs/credentials_file"
    },
    {
      "$ref": "#/$defs/key_lookup"
    },
    {
      "$ref": "#/$defs/cache_dir"
    },
    {
      "$ref": "#/$defs/cache_layout"
    }
  ],
  "$defs": {
    "one_line": {
      "description": "Text without a newline. Python's `re.search` lets an anchored pattern's `$` match before a final newline, so every pattern here anchored with `$` refers to this as well.",
      "not": {
        "pattern": "\\n"
      }
    },
    "name": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "$ref": "#/$defs/one_line"
    },
    "platform": {
      "enum": [
        "linux",
        "macos",
        "windows"
      ]
    },
    "env": {
      "description": "The environment variables set for the vector. A variable not listed is unset.",
      "type": "object",
      "propertyNames": {
        "pattern": "^[A-Z][A-Z0-9_]*$",
        "$ref": "#/$defs/one_line"
      },
      "additionalProperties": {
        "type": "string"
      }
    },
    "path": {
      "type": "string",
      "minLength": 1
    },
    "rendering": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "format",
        "bundle"
      ],
      "properties": {
        "format": {
          "enum": [
            "csv",
            "xlsx",
            "parquet"
          ]
        },
        "bundle": {
          "type": "boolean"
        },
        "layout": {
          "const": "frame"
        }
      }
    },
    "file_error": {
      "enum": [
        "outside_table",
        "duplicate_table",
        "duplicate_key",
        "invalid_line"
      ]
    },
    "suite": {
      "type": "object",
      "required": [
        "format_version",
        "rule",
        "vectors"
      ],
      "properties": {
        "format_version": {
          "const": 1
        },
        "vectors": {
          "type": "array",
          "minItems": 1
        }
      }
    },
    "key_format": {
      "$ref": "#/$defs/suite",
      "additionalProperties": false,
      "properties": {
        "format_version": true,
        "rule": {
          "const": "key-format"
        },
        "vectors": {
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "key",
              "verdict"
            ],
            "properties": {
              "name": {
                "$ref": "#/$defs/name"
              },
              "key": {
                "type": "string",
                "minLength": 1
              },
              "verdict": {
                "enum": [
                  "pass",
                  "warn"
                ]
              },
              "reason": {
                "enum": [
                  "unknown_prefix",
                  "not_base62",
                  "checksum_mismatch"
                ]
              }
            },
            "if": {
              "properties": {
                "verdict": {
                  "const": "warn"
                }
              }
            },
            "then": {
              "required": [
                "reason"
              ]
            },
            "else": {
              "not": {
                "required": [
                  "reason"
                ]
              }
            }
          }
        }
      }
    },
    "credentials_path": {
      "$ref": "#/$defs/suite",
      "additionalProperties": false,
      "properties": {
        "format_version": true,
        "rule": {
          "const": "credentials-path"
        },
        "vectors": {
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "platform",
              "home",
              "env",
              "path"
            ],
            "properties": {
              "name": {
                "$ref": "#/$defs/name"
              },
              "platform": {
                "$ref": "#/$defs/platform"
              },
              "home": {
                "$ref": "#/$defs/path"
              },
              "env": {
                "$ref": "#/$defs/env"
              },
              "path": {
                "$ref": "#/$defs/path"
              }
            }
          }
        }
      }
    },
    "credentials_file": {
      "$ref": "#/$defs/suite",
      "additionalProperties": false,
      "properties": {
        "format_version": true,
        "rule": {
          "const": "credentials-file"
        },
        "vectors": {
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "text"
            ],
            "oneOf": [
              {
                "required": [
                  "profiles"
                ]
              },
              {
                "required": [
                  "error"
                ]
              }
            ],
            "properties": {
              "name": {
                "$ref": "#/$defs/name"
              },
              "text": {
                "type": "string"
              },
              "profiles": {
                "type": "object",
                "additionalProperties": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "string"
                  }
                }
              },
              "error": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "reason",
                  "line"
                ],
                "properties": {
                  "reason": {
                    "$ref": "#/$defs/file_error"
                  },
                  "line": {
                    "type": "integer",
                    "minimum": 1
                  }
                }
              }
            }
          }
        }
      }
    },
    "key_lookup": {
      "$ref": "#/$defs/suite",
      "additionalProperties": false,
      "properties": {
        "format_version": true,
        "rule": {
          "const": "key-lookup"
        },
        "vectors": {
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "env",
              "file"
            ],
            "oneOf": [
              {
                "required": [
                  "source",
                  "key"
                ]
              },
              {
                "required": [
                  "error"
                ]
              }
            ],
            "properties": {
              "name": {
                "$ref": "#/$defs/name"
              },
              "api_key": {
                "description": "The api_key argument: a key string, or false to force anonymous use. Absent when the caller passes none.",
                "oneOf": [
                  {
                    "type": "string",
                    "minLength": 1
                  },
                  {
                    "const": false
                  }
                ]
              },
              "env": {
                "$ref": "#/$defs/env"
              },
              "file": {
                "description": "The text of the credentials file at the credentials path, or null when no file exists there.",
                "type": [
                  "string",
                  "null"
                ]
              },
              "source": {
                "enum": [
                  "argument",
                  "environment",
                  "credentials_file",
                  "anonymous"
                ]
              },
              "key": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "error": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "reason"
                ],
                "properties": {
                  "reason": {
                    "enum": [
                      "profile_not_found",
                      "profile_without_key",
                      "credentials_file_invalid"
                    ]
                  }
                }
              }
            }
          }
        }
      }
    },
    "cache_dir": {
      "$ref": "#/$defs/suite",
      "additionalProperties": false,
      "properties": {
        "format_version": true,
        "rule": {
          "const": "cache-dir"
        },
        "vectors": {
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "platform",
              "home",
              "env",
              "root",
              "directory"
            ],
            "properties": {
              "name": {
                "$ref": "#/$defs/name"
              },
              "platform": {
                "$ref": "#/$defs/platform"
              },
              "home": {
                "$ref": "#/$defs/path"
              },
              "cache_dir": {
                "$ref": "#/$defs/path"
              },
              "env": {
                "$ref": "#/$defs/env"
              },
              "root": {
                "$ref": "#/$defs/path"
              },
              "directory": {
                "$ref": "#/$defs/path"
              }
            }
          }
        }
      }
    },
    "cache_layout": {
      "$ref": "#/$defs/suite",
      "additionalProperties": false,
      "properties": {
        "format_version": true,
        "rule": {
          "const": "cache-layout"
        },
        "vectors": {
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "entry",
              "path"
            ],
            "oneOf": [
              {
                "properties": {
                  "entry": {
                    "const": "file"
                  }
                },
                "required": [
                  "digest"
                ],
                "not": {
                  "anyOf": [
                    {
                      "required": [
                        "spec_id"
                      ]
                    },
                    {
                      "required": [
                        "content_version"
                      ]
                    },
                    {
                      "required": [
                        "rendering"
                      ]
                    }
                  ]
                }
              },
              {
                "properties": {
                  "entry": {
                    "const": "manifest"
                  }
                },
                "required": [
                  "spec_id",
                  "content_version",
                  "rendering"
                ],
                "not": {
                  "required": [
                    "digest"
                  ]
                }
              }
            ],
            "properties": {
              "name": {
                "$ref": "#/$defs/name"
              },
              "entry": {
                "enum": [
                  "file",
                  "manifest"
                ]
              },
              "digest": {
                "type": "string",
                "pattern": "^sha256:[0-9a-f]{64}$",
                "$ref": "#/$defs/one_line"
              },
              "spec_id": {
                "type": "string",
                "pattern": "^spec_[0-9a-f]{32}$",
                "$ref": "#/$defs/one_line"
              },
              "content_version": {
                "type": "string",
                "pattern": "^cv_[0-9a-f]{32}$",
                "$ref": "#/$defs/one_line"
              },
              "rendering": {
                "$ref": "#/$defs/rendering"
              },
              "path": {
                "type": "string",
                "pattern": "^[a-z]+(/[A-Za-z0-9_.-]+)+$",
                "$ref": "#/$defs/one_line"
              }
            }
          }
        }
      }
    }
  }
}
