{
  "format_version": 1,
  "rule": "credentials-path",
  "vectors": [
    {
      "name": "explicit-file-wins",
      "platform": "linux",
      "home": "/home/ana",
      "env": {
        "DFO_CREDENTIALS_FILE": "/etc/dfo/ci.toml",
        "XDG_CONFIG_HOME": "/home/ana/.xdg"
      },
      "path": "/etc/dfo/ci.toml"
    },
    {
      "name": "explicit-file-wins-on-windows",
      "platform": "windows",
      "home": "C:\\Users\\ana",
      "env": {
        "DFO_CREDENTIALS_FILE": "D:\\keys\\dfo.toml",
        "APPDATA": "C:\\Users\\ana\\AppData\\Roaming"
      },
      "path": "D:\\keys\\dfo.toml"
    },
    {
      "name": "xdg-config-home-on-linux",
      "platform": "linux",
      "home": "/home/ana",
      "env": {
        "XDG_CONFIG_HOME": "/home/ana/.xdg"
      },
      "path": "/home/ana/.xdg/dfo/credentials.toml"
    },
    {
      "name": "xdg-config-home-on-macos",
      "platform": "macos",
      "home": "/Users/ana",
      "env": {
        "XDG_CONFIG_HOME": "/Users/ana/.xdg"
      },
      "path": "/Users/ana/.xdg/dfo/credentials.toml"
    },
    {
      "name": "default-on-linux",
      "platform": "linux",
      "home": "/home/ana",
      "env": {},
      "path": "/home/ana/.config/dfo/credentials.toml"
    },
    {
      "name": "default-on-macos",
      "platform": "macos",
      "home": "/Users/ana",
      "env": {},
      "path": "/Users/ana/.config/dfo/credentials.toml"
    },
    {
      "name": "empty-values-count-as-unset",
      "platform": "linux",
      "home": "/home/ana",
      "env": {
        "DFO_CREDENTIALS_FILE": "",
        "XDG_CONFIG_HOME": ""
      },
      "path": "/home/ana/.config/dfo/credentials.toml"
    },
    {
      "name": "appdata-on-windows",
      "platform": "windows",
      "home": "C:\\Users\\ana",
      "env": {
        "APPDATA": "C:\\Users\\ana\\AppData\\Roaming"
      },
      "path": "C:\\Users\\ana\\AppData\\Roaming\\dfo\\credentials.toml"
    },
    {
      "name": "windows-ignores-xdg",
      "platform": "windows",
      "home": "C:\\Users\\ana",
      "env": {
        "APPDATA": "C:\\Users\\ana\\AppData\\Roaming",
        "XDG_CONFIG_HOME": "C:\\xdg"
      },
      "path": "C:\\Users\\ana\\AppData\\Roaming\\dfo\\credentials.toml"
    },
    {
      "name": "windows-without-appdata",
      "platform": "windows",
      "home": "C:\\Users\\ana",
      "env": {},
      "path": "C:\\Users\\ana\\AppData\\Roaming\\dfo\\credentials.toml"
    }
  ]
}
