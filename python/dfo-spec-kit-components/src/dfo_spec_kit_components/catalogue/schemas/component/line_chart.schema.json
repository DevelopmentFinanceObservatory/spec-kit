{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://developmentfinance.org/presentation/schema/v1/component/line_chart.schema.json",
  "title": "line_chart component",
  "description": "Resolved payload for the `line_chart` catalogue member (Contract, \"Worked component: the line chart\").",
  "type": "object",
  "additionalProperties": false,
  "unevaluatedProperties": false,
  "required": [
    "type",
    "title",
    "series",
    "x_axis",
    "y_axis"
  ],
  "properties": {
    "type": {
      "const": "line_chart"
    },
    "title": {
      "type": "object",
      "additionalProperties": false,
      "unevaluatedProperties": false,
      "required": [
        "text",
        "authorship"
      ],
      "properties": {
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "authorship": {
          "$comment": "Only \"model\" exists at launch (Contract's Model-authored-claims row); the enum stays closed rather than open-string so a future first-party/user authorship arrives as a deliberate catalogue change.",
          "enum": [
            "model"
          ]
        }
      }
    },
    "series": {
      "type": "array",
      "minItems": 1,
      "maxItems": 50,
      "items": {
        "$ref": "#/$defs/series"
      }
    },
    "x_axis": {
      "type": "object",
      "additionalProperties": false,
      "unevaluatedProperties": false,
      "required": [
        "window"
      ],
      "properties": {
        "window": {
          "$ref": "#/$defs/window"
        }
      }
    },
    "y_axis": {
      "type": "object",
      "additionalProperties": false,
      "unevaluatedProperties": false,
      "required": [
        "label",
        "scale",
        "range"
      ],
      "properties": {
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "scale": {
          "enum": [
            "linear",
            "log"
          ]
        },
        "range": {
          "$ref": "#/$defs/range"
        }
      }
    }
  },
  "$defs": {
    "period": {
      "type": "string",
      "pattern": "^[0-9]{4}(-(0[1-9]|1[0-2])(-(0[1-9]|[12][0-9]|3[01]))?)?$",
      "maxLength": 10
    },
    "window": {
      "type": "object",
      "additionalProperties": false,
      "unevaluatedProperties": false,
      "required": [
        "start",
        "end"
      ],
      "properties": {
        "start": {
          "$ref": "#/$defs/period"
        },
        "end": {
          "$ref": "#/$defs/period"
        }
      }
    },
    "range": {
      "type": "object",
      "additionalProperties": false,
      "unevaluatedProperties": false,
      "required": [
        "min",
        "max"
      ],
      "properties": {
        "min": {
          "type": [
            "number",
            "null"
          ]
        },
        "max": {
          "type": [
            "number",
            "null"
          ]
        }
      }
    },
    "unit": {
      "$comment": "Pass-through unit slot: null, an opaque graph-ref string, a structured object, or a composed unit, the unit of a quotient of two measures. No conversion happens in Presentation; the structured object's own field set is seam-owed to the upstream unit design.",
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        {
          "$ref": "#/$defs/structured_unit"
        },
        {
          "$ref": "#/$defs/composed_unit"
        }
      ]
    },
    "structured_unit": {
      "type": "object",
      "additionalProperties": false,
      "unevaluatedProperties": false,
      "minProperties": 1,
      "properties": {
        "currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$"
        },
        "magnitude": {
          "type": "string",
          "enum": [
            "units",
            "thousands",
            "millions",
            "billions",
            "trillions"
          ]
        },
        "prices": {
          "enum": [
            "current",
            "constant"
          ]
        },
        "base_year": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1900,
          "maximum": 2100
        }
      }
    },
    "composed_unit": {
      "$comment": "The unit of a quotient of two measures, read `<numerator> per <denominator>`. Each part is a unit_part, so a part is never null and never itself a composed unit.",
      "type": "object",
      "additionalProperties": false,
      "unevaluatedProperties": false,
      "required": [
        "numerator",
        "denominator"
      ],
      "properties": {
        "numerator": {
          "$ref": "#/$defs/unit_part"
        },
        "denominator": {
          "$ref": "#/$defs/unit_part"
        }
      }
    },
    "unit_part": {
      "$comment": "One side of a composed unit: the side's unit as a string or a structured object, or, for a measure that declares no unit, the StatVar it counts.",
      "oneOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        {
          "$ref": "#/$defs/structured_unit"
        },
        {
          "$ref": "#/$defs/counted_stat_var"
        }
      ]
    },
    "counted_stat_var": {
      "$comment": "A unit-less measure named by its StatVar. `stat_var` is the `dcid:`-prefixed reference the frame grammar pins; `label` is the StatVar's graph name, or the reference without `dcid:` when the graph has none.",
      "type": "object",
      "additionalProperties": false,
      "unevaluatedProperties": false,
      "required": [
        "stat_var",
        "label"
      ],
      "properties": {
        "stat_var": {
          "type": "string",
          "pattern": "^dcid:.",
          "maxLength": 200
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        }
      }
    },
    "point": {
      "type": "object",
      "additionalProperties": false,
      "unevaluatedProperties": false,
      "required": [
        "period"
      ],
      "properties": {
        "period": {
          "$ref": "#/$defs/period"
        },
        "value": {
          "type": "number"
        },
        "status": {
          "$comment": "The status vocabulary the contract reserves: a derived-missing point (no observation for a visible series over the window/grain) and the source-supplied statuses that pass through unchanged.",
          "enum": [
            "missing",
            "suppressed",
            "not_applicable"
          ]
        }
      },
      "oneOf": [
        {
          "required": [
            "value"
          ],
          "properties": {
            "status": false
          }
        },
        {
          "required": [
            "status"
          ],
          "properties": {
            "value": false
          }
        }
      ]
    },
    "series": {
      "type": "object",
      "additionalProperties": false,
      "unevaluatedProperties": false,
      "required": [
        "id",
        "label",
        "unit",
        "source_ref",
        "points"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9_]{1,64}$",
          "not": {
            "pattern": "\\n"
          },
          "description": "derived by the assembler from the series' coordinates; the same selection always yields the same id"
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "unit": {
          "$ref": "#/$defs/unit"
        },
        "source_ref": {
          "$ref": "#/$defs/source_ref"
        },
        "points": {
          "type": "array",
          "minItems": 1,
          "maxItems": 500,
          "items": {
            "$ref": "#/$defs/point"
          }
        }
      }
    },
    "source_ref": {
      "description": "the source a value came from: on a payload with a `description`, the `ref` of an entry in `description.sources` (a provenance dcid such as `provenance/OECDCreditorReportingSystem`); otherwise the `src_` id of an entry in `provenance.sources`, which the envelope schema holds to the `src_` pattern",
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    }
  }
}
